# Web Security Agents - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# REQUIRED - Google AI API Key
# =============================================================================
# Get your API key from: https://aistudio.google.com/apikey
# Required for: ALL lessons (L01-L06)
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# OPTIONAL - External Security APIs
# =============================================================================

# VirusTotal API Key
# Get your API key from: https://www.virustotal.com/gui/join-us
# Required for: L03.1 (VT MCP Server), L06 (Capstone Agent)
# Free tier: 4 requests/minute, 500 requests/day
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# URLScan.io API Key
# Get your API key from: https://urlscan.io/ (sign up, then go to Settings > API)
# Required for: L03.2 (URLScan MCP Server), L06 (Capstone Agent)
# Free tier: 50 scans/day
URLSCAN_API_KEY=your_urlscan_api_key_here

# =============================================================================
# OPTIONAL - Ollama Configuration (Local Models)
# =============================================================================

# Ollama API Base URL
# Only needed for: L01.2 (Ollama agent)
# Default: http://localhost:11434 (if running Ollama locally via Docker)
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Security: Never commit this file with real API keys to version control
#    The .gitignore file should already exclude .env files
#
# 2. Workshop Flow: You can start with just GOOGLE_API_KEY and add others
#    as you progress through the lessons
#
# 3. Rate Limits: Free tier APIs have strict limits. The workshop includes
#    cached data in the data/ folder to avoid hitting limits during demos
#
# 4. Alternative: You can also set these as environment variables instead
#    of using a .env file:
#      export GOOGLE_API_KEY=your_key_here
#      export VIRUSTOTAL_API_KEY=your_key_here
#      export URLSCAN_API_KEY=your_key_here
#
